# PostgreSQL connection string. The default matches docker-compose.yml (host port 5434).
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/capital_tracker?schema=public"

# Public URL of the app, used by NextAuth.
NEXTAUTH_URL="http://localhost:3000"

# Signs the session JWT. This placeholder is for local development only:
# generate a real value for any shared or production environment with `openssl rand -base64 32`.
NEXTAUTH_SECRET="dev-only-change-me-generate-with-openssl-rand-base64-32"
